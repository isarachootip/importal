# App
NEXT_PUBLIC_APP_NAME=Importal
NEXT_PUBLIC_APP_URL=http://localhost:3000
TZ=Asia/Bangkok

# Database (Docker Compose default port 5442 to avoid local 5432 collision)
POSTGRES_USER=importal
POSTGRES_PASSWORD=importal_dev
POSTGRES_DB=importal
POSTGRES_PORT=5442
DATABASE_URL="postgresql://importal:importal_dev@localhost:5442/importal?schema=public"

# Auth (Dev Role Switcher enabled in local dev; SSO configured for production @chg.co.th)
AUTH_DEV_MODE=true
AUTH_ALLOWED_DOMAIN=chg.co.th
AUTH_SECRET="replace-with-random-32-char-secret"
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# S3 / MinIO Storage
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
S3_ENDPOINT=http://localhost:9010
S3_REGION=ap-southeast-1
S3_BUCKET=importal-files
S3_ACCESS_KEY=importal
S3_SECRET_KEY=importal_secret
S3_FORCE_PATH_STYLE=true

# SMTP / Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Importal <no-reply@chg.co.th>"
APP_BASE_URL=http://localhost:3000
CRON_SECRET="importal-cron-dev-secret"
