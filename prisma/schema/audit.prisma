enum NotificationType {
  YOUR_TURN
  PRE_QC_REJECTED
  REVISION_REQUESTED
  APPROVED
  OVERDUE_DIGEST
}

model AuditEvent {
  id          String      @id @default(cuid())
  caseId      String
  actorId     String
  actorRole   RoleCode
  stage       ImportStage
  stepKey     String?
  action      String
  beforeState Json?
  afterState  Json?
  reason      String?
  metadata    Json?
  createdAt   DateTime    @default(now())

  importCase ImportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor      User       @relation(fields: [actorId], references: [id])

  @@index([caseId, createdAt])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  caseId      String?
  type        NotificationType
  title       String
  body        String
  isRead      Boolean          @default(false)
  emailSentAt DateTime?
  createdAt   DateTime         @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  importCase ImportCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
