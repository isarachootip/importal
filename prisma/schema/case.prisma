enum ImportStage {
  SOURCING
  PACKAGING
  PURCHASE_ORDER
  PRODUCTION
  LOGISTIC
  CLOSED
}

enum SourcingStatus {
  DRAFT
  RFQ_SENT
  QUOTE_RECEIVED
  NEGOTIATING
  OFFER_SELECTED
  APPROVED
}

enum PoStatus {
  NOT_STARTED
  PO_DRAFT
  PO_APPROVED
  PO_SENT
  PO_ACCEPTED
}

enum ProductionStatus {
  NOT_STARTED
  PO_ACCEPTED
  DEPOSIT_PAID
  MATERIAL_PREP
  IN_PRODUCTION
  QC_INSPECTION
  READY_TO_SHIP
}

enum LogisticStatus {
  NOT_STARTED
  BOOKED
  EXPORT_CLEARED_CN
  DEPARTED
  ARRIVED_TH
  CUSTOMS_CLEARED_TH
  DELIVERED_TO_WH
  RECEIVED_COMPLETE
  ISSUE_REPORTED
}

enum CaseDocType {
  QUOTATION
  PO_FILE
  QC_REPORT
  COMMERCIAL_INVOICE
  PACKING_LIST
  BILL_OF_LADING
  FORM_E
  IMPORT_DECLARATION
  OTHER
}

model ImportCase {
  id               String           @id @default(cuid())
  caseCode         String           @unique
  productTitle     String
  brandId          String
  ownerId          String
  subclassId       String?
  vendorId         String?
  currentStage     ImportStage      @default(SOURCING)
  sourcingStatus   SourcingStatus   @default(DRAFT)
  poStatus         PoStatus         @default(NOT_STARTED)
  productionStatus ProductionStatus @default(NOT_STARTED)
  logisticStatus   LogisticStatus   @default(NOT_STARTED)

  isNewPhoto       Boolean @default(false)
  requiresTisi     Boolean @default(false)
  requiresFda      Boolean @default(false)
  isTileImport     Boolean @default(false)
  isNewBrandOrLogo Boolean @default(false)

  sourcingPlanEnd   DateTime? @db.Date
  sourcingActualEnd DateTime? @db.Date
  poPlanEnd         DateTime? @db.Date
  poActualEnd       DateTime? @db.Date
  prodPlanEnd       DateTime? @db.Date
  prodActualEnd     DateTime? @db.Date
  logisticPlanEnd   DateTime? @db.Date
  logisticActualEnd DateTime? @db.Date

  poNumber        String?   @unique
  poTotalAmount   Decimal?  @db.Decimal(14, 2)
  poCurrency      String?   @default("USD")
  incoterm        String?
  shippingMode    String?
  forwarderName   String?
  blOrAwbNumber   String?
  containerNumber String?
  etd             DateTime? @db.Date
  eta             DateTime? @db.Date
  whIssueNote     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  brand         Brand               @relation(fields: [brandId], references: [id])
  owner         User                @relation("CaseOwner", fields: [ownerId], references: [id])
  subclass      ProductSubclass?    @relation(fields: [subclassId], references: [id])
  vendor        VendorFactory?      @relation(fields: [vendorId], references: [id])
  quotations    SourcingQuotation[]
  packaging     PackagingJob?
  documents     CaseDocument[]
  auditEvents   AuditEvent[]
  notifications Notification[]

  @@index([currentStage])
  @@index([brandId])
  @@index([ownerId])
}

model SourcingQuotation {
  id           String   @id @default(cuid())
  caseId       String
  vendorId     String?
  vendorName   String
  unitPrice    Decimal  @db.Decimal(12, 4)
  currency     String   @default("USD")
  moq          Int
  leadTimeDays Int
  incoterm     String
  notes        String?
  isSelected   Boolean  @default(false)
  createdAt    DateTime @default(now())

  importCase ImportCase     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  vendor     VendorFactory? @relation(fields: [vendorId], references: [id])

  @@index([caseId])
}

model CaseDocument {
  id           String      @id @default(cuid())
  caseId       String
  stage        ImportStage
  docType      CaseDocType
  fileName     String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime    @default(now())

  importCase ImportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation(fields: [uploadedById], references: [id])

  @@index([caseId, stage])
}
