enum PackagingStepKey {
  INFO
  PRE_QC
  AW_DRAFT_1
  PROOF_1
  REVISE_1
  PROOF_2
  REVISE_2
  PROOF_3
  REVISE_3
  APPROVE_GM_VP
  APPROVE_EVP
  REVISE_FINAL
  FINAL_FILE
  COMPLETED
}

enum TimelineBoardStatus {
  PENDING_IMPORT
  PRE_QC_GD
  ON_PROCESS
  SENT_DRAFT_1
  SENT_DRAFT_2
  SENT_DRAFT_3
  APPROVE_FINAL
  APPROVED_FINAL
}

enum PiFileSlot {
  EXCEL_DATA
  DICUT_DIMENSION
  PICTURE_DATA
  MANUAL_DATA
  OLD_PATTERN_REF
  REF_OTHER
}

enum PreQcDecision {
  SUBMITTED
  REJECTED
}

enum ArtworkStageKind {
  DRAFT_1
  REVISE_1
  DRAFT_2
  REVISE_2
  DRAFT_3
  REVISE_3
  REVISE_FINAL
  FINAL_FILE
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REVISION_REQUESTED
}

model PackagingJob {
  id               String              @id @default(cuid())
  caseId           String              @unique
  piNumber         String              @unique
  piDate           DateTime            @db.Date
  skuCount         Int
  caseConfigId     String
  currentStep      PackagingStepKey    @default(INFO)
  timelineStatus   TimelineBoardStatus @default(PENDING_IMPORT)
  isMinorChange    Boolean             @default(false)
  preQcRejectCount Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  importCase       ImportCase                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseConfig       PackagingCaseConfig        @relation(fields: [caseConfigId], references: [id])
  packagingTypes   PackagingJobType[]
  scheduleSteps    PackagingScheduleStep[]
  piFiles          PackagingPiFile[]
  checklistAnswers PackagingChecklistAnswer[]
  preQcReviews     PackagingPreQc[]
  artworks         PackagingArtwork[]
  approvals        PackagingApproval[]
  comments         PackagingComment[]

  @@index([timelineStatus])
  @@index([currentStep])
}

model PackagingJobType {
  packagingJobId  String
  packagingTypeId String

  packagingJob  PackagingJob  @relation(fields: [packagingJobId], references: [id], onDelete: Cascade)
  packagingType PackagingType @relation(fields: [packagingTypeId], references: [id])

  @@id([packagingJobId, packagingTypeId])
}

model PackagingScheduleStep {
  id             String           @id @default(cuid())
  packagingJobId String
  stepKey        PackagingStepKey
  plannedDays    Int
  plannedStart   DateTime         @db.Date
  plannedEnd     DateTime         @db.Date
  actualStart    DateTime?        @db.Date
  actualEnd      DateTime?        @db.Date
  isBuffer       Boolean          @default(false)

  packagingJob PackagingJob @relation(fields: [packagingJobId], references: [id], onDelete: Cascade)

  @@unique([packagingJobId, stepKey])
}

model PackagingPiFile {
  id             String     @id @default(cuid())
  packagingJobId String
  slot           PiFileSlot
  version        Int        @default(1)
  fileName       String
  storageKey     String
  mimeType       String
  sizeBytes      Int
  uploadedById   String
  createdAt      DateTime   @default(now())

  packagingJob PackagingJob @relation(fields: [packagingJobId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])

  @@index([packagingJobId, slot])
}

model PackagingChecklistAnswer {
  id              String   @id @default(cuid())
  packagingJobId  String
  checklistItemId String
  checked         Boolean  @default(false)
  note            String?
  updatedAt       DateTime @updatedAt

  packagingJob  PackagingJob        @relation(fields: [packagingJobId], references: [id], onDelete: Cascade)
  checklistItem ChecklistItemConfig @relation(fields: [checklistItemId], references: [id])

  @@unique([packagingJobId, checklistItemId])
}

model PackagingPreQc {
  id             String        @id @default(cuid())
  packagingJobId String
  round          Int
  decision       PreQcDecision
  failedCodes    String[]
  note           String?
  reviewerId     String
  createdAt      DateTime      @default(now())

  packagingJob PackagingJob @relation(fields: [packagingJobId], references: [id], onDelete: Cascade)
  reviewer     User         @relation(fields: [reviewerId], references: [id])

  @@index([packagingJobId, round])
}

model PackagingArtwork {
  id             String           @id @default(cuid())
  packagingJobId String
  stageKind      ArtworkStageKind
  version        Int              @default(1)
  fileName       String
  storageKey     String
  mimeType       String
  sizeBytes      Int
  uploadedById   String
  createdAt      DateTime         @default(now())

  packagingJob PackagingJob       @relation(fields: [packagingJobId], references: [id], onDelete: Cascade)
  uploadedBy   User               @relation(fields: [uploadedById], references: [id])
  comments     PackagingComment[]

  @@index([packagingJobId, stageKind])
}

model PackagingApproval {
  id             String           @id @default(cuid())
  packagingJobId String
  stepKey        PackagingStepKey
  round          Int              @default(1)
  stepOrder      Int
  role           RoleCode
  decision       ApprovalDecision @default(PENDING)
  reason         String?
  actedById      String?
  actedAt        DateTime?
  createdAt      DateTime         @default(now())

  packagingJob PackagingJob @relation(fields: [packagingJobId], references: [id], onDelete: Cascade)
  actedBy      User?        @relation(fields: [actedById], references: [id])

  @@index([packagingJobId, stepKey, decision])
}

model PackagingComment {
  id               String   @id @default(cuid())
  packagingJobId   String
  artworkVersionId String?
  authorId         String
  authorRole       RoleCode
  body             String
  pinNumber        Int?
  pinX             Float?
  pinY             Float?
  pageNumber       Int?
  createdAt        DateTime @default(now())

  packagingJob   PackagingJob      @relation(fields: [packagingJobId], references: [id], onDelete: Cascade)
  artworkVersion PackagingArtwork? @relation(fields: [artworkVersionId], references: [id], onDelete: SetNull)
  author         User              @relation(fields: [authorId], references: [id])

  @@index([packagingJobId, artworkVersionId])
}
