enum TrackerRole {
  IMPORT
  MDSG
  EVP
  DESIGNER
  PHOTOGRAPHER
  MGMT
}

enum OrgLevel {
  DIV
  DM
  GM
  VP
  EVP
  TEAM
}

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  fullName    String
  displayName String      @unique
  nickname    String?
  jobTitle    String?
  role        TrackerRole
  orgLevel    OrgLevel    @default(DM)
  groupName   String?
  sdeptCodes  Int[]
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([role])
}
